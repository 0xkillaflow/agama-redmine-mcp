# Redmine MCP Server — example configuration.
# Copy to `.env` and adjust. Reference: docs/architecture.md §8.

# Base URL of your Redmine instance (required). A trailing slash is normalized away.
REDMINE_URL=https://redmine.example.com

# API key for the single user (required in stdio mode).
# Redmine → My account → API access key. Treat it as a secret — it is never logged.
REDMINE_API_KEY=your-redmine-api-key

# Transport: "stdio" (default, local single-user) or "http" (future, multi-user placeholder).
MCP_TRANSPORT=stdio

# Per-request timeout in milliseconds (default 30000).
REDMINE_TIMEOUT_MS=30000

# Log level: debug | info | warn | error (default info). Logs go to stderr.
LOG_LEVEL=info

# Reserved for the future http transport (default 3000).
HTTP_PORT=3000

# Filesystem allowlist for the attachment tools (default: empty = no file access).
# A ":"-separated list of absolute directories (";" on Windows). The upload and
# download tools refuse any path — including via symlinks or ".." — that does not
# resolve inside one of these. Leave unset unless you actually want file access.
# REDMINE_ALLOWED_DIRECTORIES=/Users/you/redmine-files:/tmp/redmine-downloads
