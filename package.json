{
  "name": "@0xkillaflow/agama-redmine-mcp",
  "version": "2.1.0",
  "description": "Model Context Protocol (MCP) server for Redmine — exposes Redmine to AI agents as a small set of intent-shaped, well-typed tools.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "redmine",
    "ai",
    "agent",
    "llm",
    "project-management",
    "issue-tracker",
    "stdio"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agama-redmine-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xkillaflow/agama-redmine-mcp.git"
  },
  "homepage": "https://github.com/0xkillaflow/agama-redmine-mcp#readme",
  "bugs": {
    "url": "https://github.com/0xkillaflow/agama-redmine-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "gen:tools": "tsx scripts/gen-tools-doc.ts",
    "gen:tools:check": "tsx scripts/gen-tools-doc.ts --check",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
